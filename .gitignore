# Python bytecode (legacy)
__pycache__/
*.pyc
*.pyo
.venv/

# Env / secrets
.env
.env.*
!.env.example
!laravel-backend/.env.example
!laravel-backend/.env.hostinger.example
!frontend/.env.electron.example

# Google service account keys (never commit)
credentials/*.json
!credentials/.gitkeep

# Local database & data
data/
*.sqlite
*.sqlite3

# Node / frontend build artifacts
node_modules/
frontend/dist/
frontend/dist-electron/
frontend/.vite/
laravel-backend/node_modules/

# Excel lock files
templates/~$*.xlsx
**/~$*.xlsx

# Generated per-office PPMP template copies (created at runtime).
templates/end-users/*/

token.txt
