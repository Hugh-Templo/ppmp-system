# Python bytecode
__pycache__/
*.pyc
*.pyo

# Env / secrets
.env
.env.*
!.env.example
!frontend/.env.electron.example

# Local database & data
data/
*.sqlite
*.sqlite3

# Node / frontend build artifacts
node_modules/
frontend/dist/
frontend/dist-electron/
frontend/.vite/

# Excel lock files
templates/~$*.xlsx
**/~$*.xlsx

# Generated per-office PPMP template copies (created at runtime).
# Existing shared registry files under templates/end-users/ stay tracked.
templates/end-users/*/

token.txt

# Windows installer payload / output
installer/payload/
installer/vendor/
dist-installer/