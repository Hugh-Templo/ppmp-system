# Place your Google Cloud service account JSON key here as:
#   google-service-account.json
#
# Share the Drive folder "APP SYSTEM FILES" with the service account email
# as Editor, then set in laravel-backend/.env:
#   GOOGLE_SERVICE_ACCOUNT_FILE=../credentials/google-service-account.json
#   GOOGLE_DRIVE_ROOT_FOLDER_ID=<folder-id-from-Drive-URL>
#
# Do NOT commit the actual JSON key to git.
