APP_NAME="PPMP APP Consolidation System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_ppmpsys
DB_USERNAME=u123456789_ppmpuser
DB_PASSWORD="YourDatabasePasswordHere"

# File cache/session is more reliable on Hostinger shared hosting.
# Database cache makes EVERY /api call (including login) depend on MySQL.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database

JWT_SECRET=change-me-generate-a-long-random-string
JWT_TTL=60

# Production frontend origin(s) for CORS (comma-separated). Same-origin setups can reuse APP_URL.
FRONTEND_URL=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Mail — Resend free tier recommended (https://resend.com). Verify your domain first.
MAIL_MAILER=resend
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Stay within Resend free tier (3,000/month, 100/day). Do not raise these unless you upgrade Resend.
MAIL_DAILY_LIMIT=100
MAIL_MONTHLY_LIMIT=3000

# Hostinger SMTP fallback (use instead of Resend if you already have mailbox email):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=noreply@yourdomain.com
# MAIL_PASSWORD=YourMailboxPassword
# MAIL_ENCRYPTION=ssl

# Cron (every minute) so queued office-notification emails are sent:
# * * * * * cd /home/USER/domains/yourdomain.com/laravel-backend && php artisan schedule:run >> /dev/null 2>&1
