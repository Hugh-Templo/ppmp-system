APP_NAME="PPMP APP Consolidation System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local XAMPP MySQL (Hostinger: use .env.hostinger.example)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=appbac
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

JWT_SECRET=change-me-generate-a-long-random-string
JWT_TTL=60

# Frontend origin(s) for CORS (comma-separated). Dev Vite defaults below.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Mail — local default logs to storage/logs (no real send).
# Production: MAIL_MAILER=resend + RESEND_API_KEY (free tier), or Hostinger SMTP below.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# Resend free-tier caps (app will refuse email blasts that would exceed these)
MAIL_DAILY_LIMIT=100
MAIL_MONTHLY_LIMIT=3000

# Hostinger SMTP fallback (set MAIL_MAILER=smtp if not using Resend):
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=noreply@yourdomain.com
# MAIL_PASSWORD=
# MAIL_SCHEME=null
# MAIL_ENCRYPTION=ssl

# Google Drive — preferred: BAC Admin "Download for rclone" + scripts/rclone on a PC
# (Personal Gmail cannot upload via service account — 0 storage quota.)
# See scripts/rclone/README.md
# Optional legacy API settings (unused by rclone package download):
# GOOGLE_SERVICE_ACCOUNT_FILE=../credentials/google-service-account.json
# GOOGLE_DRIVE_ROOT_FOLDER_ID=

