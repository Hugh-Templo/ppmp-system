APP_NAME="PPMP APP Consolidation System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local XAMPP MySQL (Hostinger: use .env.hostinger.example)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=appbac
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

JWT_SECRET=change-me-generate-a-long-random-string
JWT_TTL=60

# Frontend origin(s) for CORS (comma-separated). Dev Vite defaults below.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Drive (bacadmin Upload to Drive)
# Place JSON key at credentials/google-service-account.json (repo root) and share
# the "APP SYSTEM FILES" Drive folder with the service account as Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=../credentials/google-service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=

