<?xml version="1.0" encoding="UTF-8"?>
<service>
  <id>PPMP-API</id>
  <name>PPMP API</name>
  <description>Ormoc City PPMP-APP FastAPI backend (uvicorn)</description>
  <executable>{{PYTHON}}</executable>
  <arguments>-m uvicorn app.main:app --host 0.0.0.0 --port {{PORT}}</arguments>
  <workingdirectory>{{INSTALL_DIR}}</workingdirectory>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <logpath>{{INSTALL_DIR}}\logs</logpath>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="20 sec"/>
  <resetfailure>1 hour</resetfailure>
  <startmode>Automatic</startmode>
  <env name="PYTHONPATH" value="{{INSTALL_DIR}}"/>
  <env name="RCLONE_PATH" value="{{RCLONE}}"/>
  <env name="PATH" value="{{INSTALL_DIR}}\tools\rclone;{{INSTALL_DIR}}\runtime\python;%PATH%"/>
</service>
